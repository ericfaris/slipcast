# Public URL where Slipcast is reachable by your podcast app (no trailing slash)
BASE_URL=https://slipcast.yourdomain.com

# HTTP Basic Auth (leave blank to disable)
AUTH_USER=admin
AUTH_PASS=changeme

# How many episodes to keep per channel
MAX_EPISODES_PER_CHANNEL=20

# How often to check for new videos (hours)
POLL_INTERVAL_HOURS=6

# Where to store audio files and the database (Docker volume mount)
DATA_DIR=/data

# Path to a Netscape-format cookies file exported from your browser (optional)
# Needed if YouTube returns "Sign in to confirm you're not a bot"
# Export with: yt-dlp --cookies-from-browser chrome --cookies /path/to/cookies.txt <any-url>
COOKIES_FILE=/data/cookies.txt

# Media storage: "local" keeps audio/thumbnails under DATA_DIR; "r2" stores them
# in a private Cloudflare R2 bucket. docker-compose.yml defaults to r2 (and the
# app refuses to start without all four R2_* values), so set STORAGE=local
# explicitly until the library has been migrated — see README "Media storage".
STORAGE=local
# Bucket-scoped R2 API token ("Object Read & Write" on this one bucket only),
# created in the Cloudflare dashboard (R2 -> Manage API tokens). Never commit.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=slipcast-media
